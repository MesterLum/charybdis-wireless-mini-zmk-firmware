#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&trackball_listener {
    /* base processor chain on all layers */
    /* 1:3 at cpi=3200 -> ~1067 effective CPI (1:1 was 3200 and felt too fast).
       Speed lives HERE, smoothness lives in cpi. The sensor keeps producing
       3200-CPI steps and the scaler carries remainders, so dividing down costs
       no counts and no granularity - only travel distance.
       Other options:  1 2 -> 1600   2 5 -> 1280   3 4 -> 2400   5 5 -> 3200
       Never lower cpi to slow the pointer - that is what costs smoothness. */
    input-processors = <&zip_xy_scaler 1 3>;

    /* SCROLL layer (index 4) - ball becomes a scroll wheel */
    scroller: scroller {
        layers           = <4>;   // SCROLL - keep in sync with the keymap
        input-processors = <
            &zip_xy_scaler 1 120                             // Scales the scroll speed
            &zip_xy_to_scroll_mapper                         // Converts XY movement to scroll events
            &zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT) // Inverts the scroll direction
        >;
    };

    /* SLOW layer (index 5) - precision pointer */
    slow_pointer: slow_pointer {
        layers           = <5>;   // SLOW - keep in sync with the keymap
        input-processors = <&zip_xy_scaler 2 24>;
    };
};
